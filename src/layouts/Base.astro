---
import "../styles/global.css";
import { site } from "../site";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon.png" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <script is:inline>
            (() => {
                const stored = localStorage.getItem("theme");
                const system = window.matchMedia("(prefers-color-scheme: dark)")
                    .matches
                    ? "dark"
                    : "light";
                document.documentElement.dataset.theme = stored || system;
            })();
        </script>
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <div class="shell">
            <header class="masthead">
                <a class="masthead__name" href="/">{site.name}</a>
                <nav class="masthead__nav" aria-label="Primary">
                    {
                        site.nav.map((item) => (
                            <a href={item.href}>{item.label}</a>
                        ))
                    }
                </nav>
            </header>
            <main id="main">
                <slot />
            </main>
            <footer class="colophon">
                <a href={`mailto:${site.email}`}>{site.email}</a>
            </footer>
        </div>
        <button
            class="switch theme-toggle"
            type="button"
            data-theme-toggle
            role="switch"
            aria-checked="false"
            aria-label="Dark theme"
        >
            <span class="switch__knob"></span>
            <svg
                class="switch__icon switch__icon--sun"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="4.25"></circle>
                <path
                    d="M12 2.5v2M12 19.5v2M21.5 12h-2M4.5 12h-2M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4M18.7 18.7l-1.4-1.4M6.7 6.7L5.3 5.3"
                ></path>
            </svg>
            <svg
                class="switch__icon switch__icon--moon"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M20 14.4A8.5 8.5 0 0 1 9.6 4 8.5 8.5 0 1 0 20 14.4Z"
                ></path>
            </svg>
        </button>
        <script is:inline>
            const themeToggle = document.querySelector("[data-theme-toggle]");

            if (themeToggle) {
                const syncToggleState = () => {
                    themeToggle.setAttribute(
                        "aria-checked",
                        String(
                            document.documentElement.dataset.theme === "dark",
                        ),
                    );
                };

                syncToggleState();
                themeToggle.addEventListener("click", () => {
                    document.documentElement.dataset.theme =
                        document.documentElement.dataset.theme === "dark"
                            ? "light"
                            : "dark";
                    localStorage.setItem(
                        "theme",
                        document.documentElement.dataset.theme,
                    );
                    syncToggleState();
                });
            }
        </script>
    </body>
</html>
