---
interface Feature {
    src: string;
    alt: string;
    title: string;
    text: string;
}

interface Props {
    features: Feature[];
}

const { features } = Astro.props;
---

<section class="features" aria-label="How it works" data-reveal>
    <div class="features__list">
        {
            features.map((feature, index) => (
                <article class:list={["feature", index % 2 === 1 && "feature--reverse"]}>
                    <div class="feature__media">
                        <img src={feature.src} alt={feature.alt} loading="lazy" decoding="async" />
                    </div>
                    <div class="feature__copy">
                        <p class="feature__index">0{index + 1}</p>
                        <h2 class="feature__title">{feature.title}</h2>
                        <p class="feature__text">{feature.text}</p>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    .features {
        margin-top: clamp(4rem, 11vh, 7rem);
    }

    .features__list {
        display: grid;
        gap: clamp(3rem, 10vw, 7rem);
    }

    .feature {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(1.5rem, 5vw, 5rem);
        align-items: center;
    }

    .feature__media {
        display: grid;
        aspect-ratio: 16 / 10;
        background: var(--raise);
        border: 1px solid var(--rule);
        overflow: hidden;
    }

    .feature__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .feature__copy {
        max-width: 27rem;
    }

    .feature__index {
        margin: 0 0 0.75rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--accent);
    }

    .feature__title {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(1.7rem, 3.5vw, 2.75rem);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
    }

    .feature__text {
        margin: 0.9rem 0 0;
        max-width: 32ch;
        color: var(--muted);
    }

    @media (min-width: 52rem) {
        .feature {
            grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
        }

        .feature--reverse {
            grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr);
        }

        .feature--reverse .feature__media {
            grid-column: 2;
        }

        .feature--reverse .feature__copy {
            grid-column: 1;
            grid-row: 1;
        }
    }
</style>
