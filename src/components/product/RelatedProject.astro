---
interface Props {
    title: string;
    text: string;
    href: string;
    label: string;
    media: string;
    alt: string;
}

const { title, text, href, label, media, alt } = Astro.props;
---

<section class="related" aria-labelledby="related-title" data-reveal>
    <div class="related__media">
        <img src={media} alt={alt} loading="lazy" decoding="async" />
    </div>
    <div class="related__copy">
        <p class="related__eyebrow">In practice</p>
        <h2 id="related-title" class="related__title">{title}</h2>
        <p class="related__text">{text}</p>
        <a class="related__link" href={href}>
            {label}
            <svg
                class="related__arrow"
                viewBox="0 0 16 16"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
            </svg>
        </a>
    </div>
</section>

<style>
    .related {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(15rem, 0.75fr);
        gap: clamp(1.5rem, 5vw, 5rem);
        align-items: center;
        margin-top: clamp(4rem, 11vh, 7rem);
        padding-top: clamp(1.5rem, 4vw, 2.5rem);
        border-top: 1px solid var(--rule);
    }

    .related__media {
        overflow: hidden;
        border: 1px solid var(--rule);
        background: var(--raise);
        aspect-ratio: 16 / 10;
    }

    .related__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .related__copy {
        max-width: 27rem;
    }

    .related__eyebrow {
        margin: 0 0 0.75rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .related__title {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(1.7rem, 3.5vw, 2.75rem);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
    }

    .related__text {
        margin: 0.9rem 0 0;
        max-width: 32ch;
        color: var(--muted);
    }

    .related__link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.4rem;
        padding: 0.65rem 1.2rem;
        border: 1px solid var(--rule);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition:
            border-color 0.22s ease,
            color 0.22s ease;
    }

    .related__link:hover,
    .related__link:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
    }

    .related__arrow {
        width: 0.8rem;
        height: 0.8rem;
        transition: transform 0.22s ease;
    }

    .related__link:hover .related__arrow {
        transform: translateX(0.15rem);
    }

    @media (max-width: 52rem) {
        .related {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .related__link,
        .related__arrow {
            transition: none;
        }

        .related__link:hover .related__arrow {
            transform: none;
        }
    }
</style>
